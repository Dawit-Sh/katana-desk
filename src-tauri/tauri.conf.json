{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katana Desk",
  "version": "0.2.0",
  "identifier": "dev.dawitsh.katana-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Katana Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' blob: asset: http://asset.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost kcover: http://kcover.localhost kpage: http://kpage.localhost",
        "font-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data: kpage: http://kpage.localhost",
        "frame-src": "'self' blob:",
        "worker-src": "'self' blob:"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Katana",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "A reader that syncs with Grimmory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "longDescription": "A reader for EPUB, MOBI, AZW3, FB2, PDF, DjVu and comics that syncs reading places, highlights and bookmarks with Grimmory, with built-in offline dictionaries.",
    "homepage": "https://github.com/Dawit-Sh/katana-desk",
    "license": "GPL-3.0-or-later",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "recommends": [
          "libarchive-tools"
        ]
      },
      "rpm": {
        "recommends": [
          "bsdtar"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2QTAyOEI0OTBFOUZDRjcKUldUMy9PbVF0Q2lncHN1SUtuRW94aXI5SUVoRUp6VlpLOHhJeG1TM3VHTktJSzdUWnhzMStWTngK",
      "endpoints": [
        "https://github.com/Dawit-Sh/katana-desk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
