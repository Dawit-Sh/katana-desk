{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Katana Desk",
  "version": "0.1.0",
  "identifier": "dev.dawitsh.katana-desk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Katana Desk",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob: asset: http://asset.localhost",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: data:",
        "frame-src": "'self' blob:"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Katana",
    "copyright": "GPL-3.0-or-later",
    "category": "Utility",
    "shortDescription": "A reader that syncs with Grimmory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
